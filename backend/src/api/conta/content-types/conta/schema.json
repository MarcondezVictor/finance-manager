{
  "kind": "collectionType",
  "collectionName": "contas",
  "info": {
    "singularName": "conta",
    "pluralName": "contas",
    "displayName": "Conta"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string"
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "banco",
        "carteira_digital",
        "dinheiro",
        "investimento"
      ]
    },
    "saldoInicial": {
      "type": "decimal"
    },
    "movimentos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::movimento.movimento",
      "mappedBy": "conta"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "contas"
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
